{
  "name": "little-cloud-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4196 --strictPort",
    "build": "vite build",
    "preview": "npm run play",
    "play": "npm run build && vite preview --host 127.0.0.1 --port 4197 --strictPort",
    "assets": "node scripts/prepare-vision.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/arcade.browser.mjs",
    "test:clearance": "node tests/delivery-clearance.browser.mjs",
    "test:carousel": "node tests/carousel.browser.mjs",
    "test:contact": "node tests/contact.browser.mjs",
    "test:camera": "node tests/camera.browser.mjs",
    "check": "npm test && npm run build",
    "check:booth": "npm run check && node scripts/check-browser.mjs",
    "start": "node server/index.js",
    "test:shared": "node tests/shared-session.browser.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.185.1",
    "three-mesh-bvh": "0.9.14"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
